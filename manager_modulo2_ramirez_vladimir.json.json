      "parameters": {
        "jsCode": "const items = $input.all().filter(i => i.json && Object.keys(i.json).length > 0);\nlet error = '';\nlet first = {};\n\nif (items.length === 0) {\n  error = \"Customer not found\";\n} else {\n  first = items[0].json;\n}\n\nif (error === \"\"  && first.id) { \n    error = \"Airtable validation failed: record is missing an id.\";\n   \n}\n\nif (error === \"\" && (!first.fields || typeof first.fields !== \"object\")) {\n    error = \"Airtable validation failed: record has no fields.\";  \n}\n\nif (error === \"\") {\n  return { json: { valid: true, customer: first }} \n}\n\nreturn { json: { valid: false, error: error }}"
      },
