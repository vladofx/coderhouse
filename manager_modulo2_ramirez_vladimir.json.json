    {
      "parameters": {
        "jsCode": "const raw = $input.first().json.chatInput;\n\n// 1. Presence / non-empty check\nif (raw === undefined || raw === null || (typeof raw === \"string\" && raw.trim() === \"\")) {\n  throw new Error(\"Validation failed: no message received (chatInput is empty).\");\n}\n\n// 2. Already an object? pass it through\nif (typeof raw === \"object\") {\n  return { json: { valid: true, message: raw } };\n}\n\n// 3. Must be valid JSON\nlet parsed;\ntry {\n  parsed = JSON.parse(raw);\n} catch (e) {\n  throw new Error(\"Validation failed: message is not valid JSON. \" + e.message);\n}\n\n// 4. Must be a JSON object (not a bare string/number)\nif (typeof parsed !== \"object\" || parsed === null) {\n  throw new Error(\"Validation failed: parsed JSON is not an object.\");\n}\n\nreturn { json: { valid: true, message: parsed } };"
      },
